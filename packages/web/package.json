    "innate-ui": "https://pkg.pr.new/adebola-io/innate-ui@0a4d72a",
    "postcss-nesting": "^14.0.0",
    "retend": "https://pkg.pr.new/resuite/retend/retend@e89f6885",
    "retend-utils": "https://pkg.pr.new/resuite/retend/retend-utils@e89f6885",
    "retend-web": "https://pkg.pr.new/resuite/retend/retend-web@e89f6885",
    "retend-web-devtools": "https://pkg.pr.new/resuite/retend/retend-web-devtools@e89f6885",
    "shell-quote": "^1.12.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.0.0",
