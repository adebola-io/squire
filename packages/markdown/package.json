{
  "name": "@squire/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "markdown-it": "^14.1.0",
    "parse5": "^7.3.0",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
