{
  "name": "squire-ui",
  "version": "0.1.1",
  "description": "Shared Squire UI components, icons, styles, and fonts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/prepare-dist.mjs && tsc --project tsconfig.build.json && vite build && node scripts/prepare-styles.mjs",
    "watch": "node scripts/watch.mjs",
    "prepack": "pnpm build",
    "generate:icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "innate-ui": "https://pkg.pr.new/adebola-io/innate-ui@0a4d72a",
    "retend": "https://pkg.pr.new/resuite/retend/retend@e89f6885",
    "retend-utils": "https://pkg.pr.new/resuite/retend/retend-utils@e89f6885",
    "retend-web": "https://pkg.pr.new/resuite/retend/retend-web@e89f6885"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "license": "SEE LICENSE IN LICENSE"
}
